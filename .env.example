# 复制为 .env（或直接在 shell 里 export）。全部为示例值，不含任何真实密钥。
APP_ENV=dev

# 业务库：连接串格式 postgresql+psycopg://用户名:密码@主机:端口/库名
APP_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/dash_members

# pytest 建/查测试库用的管理连接串（指向 postgres 维护库）
APP_DATABASE_ADMIN_URL=postgresql+psycopg://postgres@127.0.0.1:5432/postgres

# pytest 用的测试库
APP_DATABASE_TEST_URL=postgresql+psycopg://postgres@127.0.0.1:5432/dash_members_test

# uvicorn 监听
APP_HOST=127.0.0.1
APP_PORT=8000

# 驾驶舱聚合接口缓存 TTL（秒），工单要求 10 分钟；设 0 禁用
APP_DASH_CACHE_TTL_SECONDS=600
